# Dev Dockerfile for Superset with ClickHouse and MSSQL drivers
# Based on the GitLab CI/CD dev image

FROM gitlab.gdpgroup.ru:5050/gdpgroup/superset_4.1.4_fork:feature-mixed-chart-v2-dev

USER root

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for MSSQL and ClickHouse drivers
RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    ca-certificates \
    build-essential \
    python3-dev \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    unixodbc-dev \
 && rm -rf /var/lib/apt/lists/*

# Install Microsoft ODBC Driver for SQL Server
RUN set -ex; \
    if grep -q "Ubuntu" /etc/os-release; then \
      OS_VERSION=$(grep VERSION_ID /etc/os-release | cut -d '=' -f2 | tr -d '"'); \
      if ! echo "14.04 16.04 18.04 20.04 22.04" | grep -wq "$OS_VERSION"; then \
        echo "Ubuntu $OS_VERSION is not currently supported." && exit 1; \
      fi; \
      curl -sSL -O https://packages.microsoft.com/config/ubuntu/$OS_VERSION/packages-microsoft-prod.deb; \
      dpkg -i packages-microsoft-prod.deb; \
      rm packages-microsoft-prod.deb; \
    elif grep -q "Debian" /etc/os-release; then \
      mkdir -p /usr/share/keyrings; \
      curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor \
        -o /usr/share/keyrings/microsoft-prod.gpg; \
      echo "deb [signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/11/prod bullseye main" \
        > /etc/apt/sources.list.d/mssql-release.list; \
    else \
      echo "Unsupported OS" && exit 1; \
    fi; \
    apt-get update; \
    ACCEPT_EULA=Y apt-get install -y msodbcsql17 mssql-tools unixodbc-dev; \
    echo 'export PATH="$PATH:/opt/mssql-tools/bin"' >> /etc/bash.bashrc; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Install Python drivers for ClickHouse and MSSQL
# Using uv pip (as in base image) or regular pip as fallback
RUN set -ex; \
    if [ -f /app/.venv/bin/activate ]; then \
        . /app/.venv/bin/activate; \
        if command -v uv >/dev/null 2>&1; then \
            uv pip install --no-cache-dir \
                clickhouse-connect \
                pyodbc; \
        else \
            pip install --no-cache-dir \
                clickhouse-connect \
                pyodbc; \
        fi; \
    else \
        if command -v python3 >/dev/null 2>&1; then \
            python3 -m pip install --no-cache-dir \
                clickhouse-connect \
                pyodbc; \
        elif command -v python >/dev/null 2>&1; then \
            python -m pip install --no-cache-dir \
                clickhouse-connect \
                pyodbc; \
        else \
            pip install --no-cache-dir \
                clickhouse-connect \
                pyodbc; \
        fi; \
    fi

# Return to superset user
USER superset




